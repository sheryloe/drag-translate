{
  "manifest_version": 3,
  "name": "드래그 번역 (Drag Translate)",
  "short_name": "드래그 번역",
  "version": "1.0.0",
  "description": "웹 페이지와 PDF에서 글자를 드래그하면 바로 번역합니다. 구글 번역은 그 자리에서, 파파고는 새 탭으로 엽니다.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "드래그 번역",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "contextMenus", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/shared/config.js", "src/shared/engines.js", "src/shared/bridge.js", "src/ui/card.js", "src/content/content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/pdf/viewer.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
